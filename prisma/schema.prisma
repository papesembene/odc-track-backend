generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String     @id @default(uuid())
  nom        String
  prenom     String
  email      String     @unique
  motDePasse String
  role       ROLE
  actif      Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  apprenant  Apprenant?
  coach      Coach?
}

model Apprenant {
  id                    String                     @id @default(uuid())
  telephone             String?
  dateNaissance         DateTime?
  genre                 String
  adresse               String
  motDePasseTemporaire  Boolean                    @default(true)
  datePremiereConnexion DateTime?
  userId                String                     @unique
  referentielId         String
  promotionId           String
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  promotion             Promotion                  @relation(fields: [promotionId], references: [id])
  referentiel           Referentiel                @relation(fields: [referentielId], references: [id])
  user                  User                       @relation(fields: [userId], references: [id])
  documents             Document[]
  situations            SituationProfessionnelle[]
}

model Coach {
  id          String   @id @default(uuid())
  specialite  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String   @unique
  utilisateur User     @relation(fields: [userId], references: [id])
}

model Referentiel {
  id          String                 @id @default(uuid())
  nom         String
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  apprenants  Apprenant[]
  promotions  PromotionReferentiel[]
}

model Promotion {
  id           String                 @id @default(uuid())
  nom          String
  annee        Int
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  apprenants   Apprenant[]
  referentiels PromotionReferentiel[]
}

model PromotionReferentiel {
  promotionId   String
  referentielId String
  promotion     Promotion   @relation(fields: [promotionId], references: [id])
  referentiel   Referentiel @relation(fields: [referentielId], references: [id])

  @@id([promotionId, referentielId])
}

model SituationProfessionnelle {
  id             String      @id @default(uuid())
  statut         STATUT
  dateDebut      DateTime
  dateFin        DateTime?
  commentaire    String?
  valide         Boolean     @default(false)
  dateValidation DateTime?
  apprenantId    String
  entrepriseId   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  apprenant      Apprenant   @relation(fields: [apprenantId], references: [id])
  entreprise     Entreprise? @relation(fields: [entrepriseId], references: [id])
}

model Entreprise {
  id         String                     @id @default(uuid())
  nom        String
  secteur    String?
  adresse    String?
  telephone  String?
  email      String?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  situations SituationProfessionnelle[]
}

model Document {
  id          String    @id @default(uuid())
  type        DOCTYPE
  fichier     String
  dateUpload  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id])
}

enum ROLE {
  ADMIN
  COACH
  POLE_EMPLOI
  APPRENANT
  MANAGER
}

enum STATUT {
  RECHERCHE_EMPLOI
  EN_STAGE
  EN_EMPLOI
  PROJET_PERSO
  POURSUITE_ETUDES
}

enum DOCTYPE {
  CONTRAT
  ATTESTATION
  LETTRE_MISSION
  CV
  AUTRE
}
